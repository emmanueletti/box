# Agent forwarding is OFF by default. Turn it on per trusted host ABOVE, e.g.:
#   Host trusted-box
#       HostName trusted-box.example.com
#       ForwardAgent yes

# Two accounts on one host (e.g. personal + work GitHub): one alias per
# identity, IdentitiesOnly pins its key. Pick via the remote URL's host --
# the alias, not the real host (git@github-work:acme/work.git).
#
# Host takes patterns: * (any run), ? (one char), ! (negate), space-separated
# list. Match order still first-wins, so put specific above broad.
#
#   Host github-work            # exact alias
#   Host *.internal.acme.com    # every internal host
#   Host prod-* !prod-legacy    # all prod-* except prod-legacy
#       HostName github.com
#       User git
#       IdentityFile ~/.ssh/e-work.pub
#       IdentitiesOnly yes

Host *
	# 1Password agent (box points this path at the real socket on macOS).
	IdentityAgent ~/.1password/agent.sock
	ForwardAgent no
