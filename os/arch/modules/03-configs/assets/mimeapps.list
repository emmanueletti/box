# Default apps: which app opens each file type and link.
#
# This is only the seed for a new Arch install. setup-default-apps.sh copies it
# to ~/.config/mimeapps.list when that file doesn't exist yet. After that, the
# live file is the machine's own and apps may change it.
#
# Change a default on this machine:
#   xdg-mime query filetype video.mkv                   # its type, e.g. video/x-matroska
#   ls /usr/share/applications ~/.local/share/applications
#                                                       # find the app's .desktop name
#   xdg-mime default mpv.desktop video/x-matroska       # set it (several types allowed)
#   xdg-mime query default video/x-matroska             # check it
#   xdg-open video.mkv                                  # try it
# Or edit ~/.config/mimeapps.list directly.
#
# Set a whole kind at once, every type the app opens:
#   box-default-browser brave
#   box-default-video mpv
#   box-default-audio mpv
#   box-default-image imv
#   box-default-pdf zathura
#   box-default-text helix
#
# Make it the default on future installs: edit the same line in this file.
#
# Reset a machine back to this seed:
#   rm ~/.config/mimeapps.list
#   bash ~/box/os/arch/modules/03-configs/setup-default-apps.sh

[Default Applications]
text/html=brave-browser.desktop
application/xhtml+xml=brave-browser.desktop
application/x-extension-htm=brave-browser.desktop
application/x-extension-html=brave-browser.desktop
