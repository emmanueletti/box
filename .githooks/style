#!/usr/bin/env bash
#
# Lints every shell script in the repo with shellcheck. Run from anywhere in
# the tree. The pre-commit hook calls this.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"

sc="$(command -v shellcheck || mise which shellcheck 2>/dev/null || true)"
if [[ -z $sc ]]; then
  echo ".githooks/style: shellcheck not found (run: mise install)" >&2
  exit 1
fi

# Every shell script: *.sh under os/, and the extensionless box-* commands.
mapfile -t files < <(
  {
    find "$root/os" -type f -name '*.sh'
    find "$root/scripts/.local/bin/box-scripts" -type f \( -name 'box-*' -o -path '*/lib/*' \)
    echo "$root/setup.sh"
  } | sort -u
)

"$sc" -S warning "${files[@]}"
echo "✅ box: shellcheck clean (${#files[@]} scripts)"
