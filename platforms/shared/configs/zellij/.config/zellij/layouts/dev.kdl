layout {
    tab name="Agent" focus=true {
        pane {
            command "zsh"
            args "-c" "claude --chrome"
        }
    }
    tab name="Code" {
        pane focus=true borderless=true {
            command "hx"
            args "."
        }
    }
    tab name="Git" {
        pane {
            command "lazygit"
        }
    }
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[default,bold]{session}"
                format_center "{tabs}"
                format_right  "{datetime}{command_battery}"
                format_space  ""

                border_enabled "false"

                mode_normal  "#[bg=blue,fg=white,bold] NOR "
                mode_locked  "#[bg=yellow,fg=black,bold] LOC "
                mode_resize  "#[bg=cyan,fg=black,bold] RES "
                mode_pane    "#[bg=magenta,fg=white,bold] PAN "
                mode_tab     "#[bg=green,fg=black,bold] TAB "
                mode_scroll  "#[bg=white,fg=black,bold] SCR "
                mode_search  "#[bg=white,fg=black,bold] SEA "
                mode_session "#[bg=red,fg=white,bold] SES "
                mode_move    "#[bg=magenta,fg=white,bold] MOV "
                mode_tmux    "#[bg=green,fg=black,bold] TMX "
                mode_enter_search "#[bg=white,fg=black,bold] SEA "
                mode_rename_pane  "#[bg=magenta,fg=white,bold] PAN "
                mode_rename_tab   "#[bg=green,fg=black,bold] TAB "
                mode_prompt       "#[bg=red,fg=white,bold] SES "

                tab_normal              "#[dim] {index} {name} "
                tab_normal_fullscreen   "#[dim] {index} {name} [F] "
                tab_normal_sync         "#[dim] {index} {name} [S] "
                tab_active              "#[bg=blue,fg=white,bold] {index} {name} "
                tab_active_fullscreen   "#[bg=blue,fg=white,bold] {index} {name} [F] "
                tab_active_sync         "#[bg=blue,fg=white,bold] {index} {name} [S] "
                tab_separator           " "

                datetime          "#[dim] 🕐 {format} "
                datetime_format   "%H:%M"
                datetime_timezone "America/Toronto"

                command_battery_command    "/usr/bin/env zsh -c box-battery-status"
                command_battery_format     "#[dim]{stdout} "
                command_battery_interval   "60"
                command_battery_rendermode "static"
            }
        }
    }
}
