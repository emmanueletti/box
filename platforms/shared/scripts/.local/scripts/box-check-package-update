#!/usr/bin/env bash
#
# Reports outdated packages from every package manager on this machine.
#
#   box-check-package-update
#
# mise everywhere, plus brew (macOS) / pacman (arch) / dnf (fedora). The Linux
# kernel is a package, so a pending kernel upgrade shows up here.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-check-lib.sh"

os="$("${BOX_ROOT:-$HOME/box}/lib/box-detect-os.sh")"

box_check_section "packages (mise)"
box_check_require mise
# Run from $HOME so only the global toolset is checked, not a project's tools.
( cd "$HOME" && box_check_run "" mise outdated )

case "$os" in
  macos)
    box_check_section "packages (brew)"
    box_check_require brew
    box_check_run "" brew outdated --verbose
    ;;

  arch)
    box_check_section "packages (pacman)"
    box_check_require checkupdates   # from pacman-contrib; no DB lock, no sudo
    box_check_run 2 checkupdates     # exit 2 == no updates
    ;;

  fedora)
    box_check_section "packages (dnf)"
    box_check_require dnf
    box_check_run 100 dnf check-update   # exit 100 == updates available
    ;;
esac
