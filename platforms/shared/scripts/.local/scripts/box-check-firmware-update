#!/usr/bin/env bash
#
# Reports pending firmware/BIOS updates.
#
#   box-check-firmware-update
#
# Linux uses fwupd (refresh metadata, then list). macOS firmware ships through
# softwareupdate, so there it defers to box-check-os-update.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-check-lib.sh"

os="$("${BOX_ROOT:-$HOME/box}/lib/box-detect-os.sh")"

case "$os" in
  macos)
    box_check_section "firmware & BIOS"
    echo "macOS firmware ships through softwareupdate (see box-check-os-update)"
    ;;

  arch | fedora)
    box_check_require fwupdmgr
    fwupdmgr refresh --force >/dev/null 2>&1 || true   # refresh metadata; 2 == already current
    box_check_run "firmware & BIOS" "0 2" "code:2" fwupdmgr get-updates   # exit 2 == nothing to update
    ;;
esac
