#!/usr/bin/env bash
#
# Installs pending firmware/BIOS updates.
#
#   box-firmware-update      # Linux fwupd; on macOS firmware ships with the OS
#
# Only Linux has real work here. Apple ships firmware through softwareupdate,
# so on macOS box-os-update is what updates it.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-update-lib.sh"

os="$(_box-os-detect)"

box_update_section "firmware & BIOS"

case "$os" in
  macos)
    echo "macOS firmware ships through softwareupdate; run box-os-update"
    ;;

  arch | fedora)
    box_update_require fwupdmgr
    fwupdmgr refresh --force >/dev/null 2>&1 || true   # refresh metadata; 2 == already current
    fwupdmgr update                                    # applies updates; prompts to confirm
    ;;
esac

echo "✅ box-firmware-update: done"
