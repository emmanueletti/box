#!/usr/bin/env bash
#
# Installs packages and records them in box's manifest.
#
#   box-pkgs-add ripgrep          # install it, then add it to the manifest
#   box-pkgs-add ripgrep bat fd   # several at once
#
# The manifest is the Brewfile on macOS and packages.list on fedora -- the list
# box installs from on a fresh machine. Installing by hand leaves that list
# behind, so the package quietly disappears the next time you set a machine up.
# This does both halves.
#
# New lines go at the end of the manifest. Move one into a nicer group by hand
# if you care where it sits; box does not read the grouping.

set -euo pipefail

[[ ${1:-} == -h || $# == 0 ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-pkgs-lib.sh"

box_pkgs_setup

# Install first. A package that will not install has no business in the
# manifest, and this way a failure leaves the repo untouched.
case "$BOX_PKGS_OS" in
  macos)
    brew install "$@"
    ;;

  fedora)
    sudo dnf install -y "$@"
    sudo dnf mark user "$@"   # mark user-requested, so dnf autoremove leaves them alone
    ;;
esac

added=0

for pkg in "$@"; do
  if existing="$(box_pkgs_find "$pkg")"; then
    echo "   kept   ${existing} (already in the manifest)"
    continue
  fi

  entry="$(box_pkgs_entry "$pkg")"
  printf '%s\n' "$entry" >> "$BOX_PKGS_MANIFEST"
  echo "   added  ${entry}"
  (( ++added ))
done

if (( added == 0 )); then
  echo "✅ box-pkgs-add: installed, manifest already up to date"
  exit 0
fi

echo "✅ box-pkgs-add: installed and added ${added} to ${BOX_PKGS_MANIFEST#"${BOX_ROOT:-$HOME/box}"/}"
echo "   commit that change so other machines get it too"
