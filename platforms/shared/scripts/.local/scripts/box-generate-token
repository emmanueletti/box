#!/usr/bin/env bash
#
# Generates a cryptographically secure hex token, good for API keys.
#
#   box-generate-token          # 32 random bytes as hex (default)
#   box-generate-token 16       # 16 random bytes as hex

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# Byte count of entropy. 32 bytes == 256 bits, plenty for a key.
bytes="${1:-32}"

if ! [[ $bytes =~ ^[0-9]+$ ]]; then
  echo "❌ box-generate-token: byte count must be a number, got '$bytes'" >&2
  exit 1
fi

# Hex is safe everywhere -- no shell-special chars to escape.
openssl rand -hex "$bytes"
