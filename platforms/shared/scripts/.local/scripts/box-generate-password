#!/usr/bin/env bash
#
# Generates a cryptographically secure password using url-safe characters.
#
#   box-generate-password       # 32 characters (default)
#   box-generate-password 20    # 20 characters

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# Number of characters in the final password.
len="${1:-32}"

if ! [[ $len =~ ^[0-9]+$ ]]; then
  echo "❌ box-generate-password: length must be a number, got '$len'" >&2
  exit 1
fi

# base64 then drop +/= so the result is url- and copy-paste-safe. Ask openssl
# for extra bytes since stripping shrinks the string, then head to exact length.
openssl rand -base64 "$((len * 2))" | tr -d '+/=' | head -c "$len"
echo
