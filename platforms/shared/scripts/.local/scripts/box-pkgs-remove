#!/usr/bin/env bash
#
# Uninstalls packages and drops them from box's manifest.
#
#   box-pkgs-remove ripgrep          # uninstall it, then take it out of the manifest
#   box-pkgs-remove ripgrep bat      # several at once
#
# The mirror of box-pkgs-add. Uninstalling by hand leaves the package in the
# list box installs from, so it comes back on the next fresh machine -- or on
# the next box-system-sync. This does both halves.

set -euo pipefail

[[ ${1:-} == -h || $# == 0 ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-pkgs-lib.sh"

box_pkgs_setup

# Take it out of the manifest first, so a half-done run leaves the machine and
# the repo agreeing that the package is on its way out.
dropped=0

for pkg in "$@"; do
  if ! found="$(box_pkgs_find "$pkg")"; then
    echo "   absent  ${pkg} (not in the manifest)"
    continue
  fi

  # -v -x -F together drop only whole lines matching the entry literally, so a
  # package whose name is a substring of another entry survives.
  tmp="${BOX_PKGS_MANIFEST}.tmp"
  grep -vxF "$found" "$BOX_PKGS_MANIFEST" > "$tmp"
  mv "$tmp" "$BOX_PKGS_MANIFEST"

  echo "   dropped ${found}"
  (( ++dropped ))
done

case "$BOX_PKGS_OS" in
  macos)
    brew uninstall "$@"
    ;;

  fedora)
    sudo dnf remove -y "$@"
    ;;
esac

if (( dropped == 0 )); then
  echo "✅ box-pkgs-remove: uninstalled, nothing to drop from the manifest"
  exit 0
fi

echo "✅ box-pkgs-remove: uninstalled and dropped ${dropped} from ${BOX_PKGS_MANIFEST#"${BOX_ROOT:-$HOME/box}"/}"
echo "   commit that change so other machines lose it too"
