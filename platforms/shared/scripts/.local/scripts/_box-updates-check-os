#!/usr/bin/env bash
#
# Reports OS/system updates from the vendor updater.
#
#   _box-updates-check-os
#
# macOS uses softwareupdate. Linux has no separate OS updater -- the kernel and
# base system ship as packages -- so there it defers to _box-updates-check-packages.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-check-lib.sh"

os="$(_box-detect-os)"

case "$os" in
  macos)
    box_check_require softwareupdate
    box_check_run "OS update" "" "re:No new software" softwareupdate -l
    ;;

  arch | fedora)
    box_check_section "OS update"
    echo "no separate OS updater on $os; kernel and base system come through packages (see _box-updates-check-packages)"
    ;;
esac
