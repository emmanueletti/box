#!/usr/bin/env bash
#
# Installs available updates on a box-managed machine (the apply side of box-check-updates).
#
#   box-update
#
# Orchestrates the box-update-* sub-tools, in order:
#   box-update-os        vendor OS updates (macOS softwareupdate)
#   box-update-packages  packages, incl. the kernel (mise/brew/pacman/dnf)
#   box-update-firmware  firmware/BIOS (Linux fwupd)
#
# Each sub-tool also runs standalone. A failing sub-tool aborts the run. Some
# steps use sudo and will prompt for your password.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

box-update-os
box-update-packages
box-update-firmware
