#!/usr/bin/env bash
#
# Installs pending firmware/BIOS updates.
#
#   _box-updates-run-firmware        # Linux fwupd; macOS firmware comes through the OS
#
# The mirror of _box-updates-check-firmware. macOS firmware ships through
# softwareupdate, so there this defers to _box-updates-run-os.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-update-lib.sh"

os="$(_box-detect-os)"

case "$os" in
  macos)
    box_update_section "firmware & BIOS"
    echo "macOS firmware ships through softwareupdate; run _box-updates-run-os"
    ;;

  arch | fedora)
    box_update_section "firmware & BIOS"
    box_update_require fwupdmgr
    fwupdmgr refresh --force >/dev/null 2>&1 || true   # refresh metadata; 2 == already current
    fwupdmgr update                                    # applies updates; prompts to confirm
    ;;
esac

echo "✅ _box-updates-run-firmware: done"
