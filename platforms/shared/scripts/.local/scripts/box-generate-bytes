#!/usr/bin/env bash
#
# Generates cryptographically secure random bytes, encoded as base64.
#
#   box-generate-bytes          # 32 random bytes as base64 (default)
#   box-generate-bytes 64       # 64 random bytes as base64

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# Number of raw random bytes before base64 encoding.
bytes="${1:-32}"

if ! [[ $bytes =~ ^[0-9]+$ ]]; then
  echo "❌ box-generate-bytes: byte count must be a number, got '$bytes'" >&2
  exit 1
fi

openssl rand -base64 "$bytes"
