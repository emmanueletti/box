#!/usr/bin/env bash
#
# Installs available updates on a box-managed machine (the apply side of box-updates-check).
#
#   box-updates-run
#
# Orchestrates the _box-update-* sub-tools, in order:
#   _box-updates-run-os        vendor OS updates (macOS softwareupdate)
#   _box-updates-run-packages  packages, incl. the kernel (mise/brew/pacman/dnf)
#   _box-updates-run-firmware  firmware/BIOS (Linux fwupd)
#
# Each sub-tool also runs standalone. A failing sub-tool does not stop the rest;
# every failure is listed at the end and the run exits non-zero. Some steps use
# sudo and will prompt for your password.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-update-lib.sh"

_box-updates-run-os       || box_update_fail os
_box-updates-run-packages || box_update_fail packages
_box-updates-run-firmware || box_update_fail firmware

box_update_summary
