#!/usr/bin/env bash
#
# Reports outdated system packages: brew on macOS, pacman/dnf on Linux.
#
#   box-pkgs-outdated
#
# On Linux the kernel and base system are packages, so a pending kernel upgrade
# shows up here rather than under box-os-outdated. The mise toolset is separate;
# box-tools-outdated reports that.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-check-lib.sh"

os="$(_box-os-detect)"

case "$os" in
  macos)
    box_check_require brew
    box_check_run "packages (brew)" "" empty brew outdated --verbose
    ;;

  arch)
    box_check_require checkupdates   # from pacman-contrib; no DB lock, no sudo
    box_check_run "packages (pacman)" 2 "code:2" checkupdates   # exit 2 == no updates
    ;;

  fedora)
    box_check_require dnf
    box_check_run "packages (dnf)" 100 "!code:100" dnf check-update   # exit 100 == updates available
    ;;
esac
