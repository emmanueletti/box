#!/usr/bin/env bash
#
# Creates an app-launcher entry for a TUI, so it shows up as a real app icon
# instead of "open a terminal and type a command".
#
#   box-tui-install <name> <command> <float|tile> <icon>   # icon: path or URL
#
# Icons: https://dashboardicons.com -- direct PNG URL is
#   https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/<name>.png

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

if (( $# != 4 )); then
  echo "❌ box-tui-install: usage: box-tui-install <name> <command> <float|tile> <icon>" >&2
  exit 1
fi

name="$1"
cmd="$2"
style="$3"
icon="$4"

if [[ $style != "float" && $style != "tile" ]]; then
  echo "❌ box-tui-install: style must be float or tile" >&2
  exit 1
fi

icon_dir="$HOME/.local/share/applications/icons"
mkdir -p "$icon_dir"

if [[ $icon =~ ^https?:// ]]; then
  icon_path="$icon_dir/$name.png"
  curl -sL -o "$icon_path" "$icon"
else
  icon_path="$icon"
fi

desktop_file="$HOME/.local/share/applications/$name.desktop"

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Name=$name
Comment=$name
Exec=xdg-terminal-exec --app-id=TUI.$style -e $cmd
Terminal=false
Type=Application
Icon=$icon_path
StartupNotify=true
EOF

chmod +x "$desktop_file"

echo "✅ box: $name added to app launcher"
