#!/usr/bin/env bash
#
# Applies package updates from every package manager on this machine.
#
#   _box-updates-run-packages        # upgrade mise tools, then brew/pacman/dnf packages
#
# The mirror of _box-updates-check-packages: what that reports, this installs.
#
# A package manager that fails does not stop the others; the run reports every
# failure at the end and exits non-zero.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

# shellcheck source=/dev/null
. "${BOX_ROOT:-$HOME/box}/lib/box-update-lib.sh"

os="$(_box-detect-os)"

box_update_section "packages (mise)"
box_update_require mise
# Run from $HOME for the global toolset. Config pins "latest", so the upgrade
# lands in this machine's mise.lock and leaves the git-tracked config alone.
( cd "$HOME" && mise upgrade ) || box_update_fail mise

case "$os" in
  macos)
    box_update_section "packages (brew)"
    box_update_require brew
    ( brew update && brew upgrade && brew cleanup ) || box_update_fail brew
    ;;

  arch)
    box_update_section "packages (pacman)"
    box_update_require pacman
    sudo pacman -Syu || box_update_fail pacman            # pacman prompts before applying
    ;;

  fedora)
    box_update_section "packages (dnf)"
    box_update_require dnf
    sudo dnf upgrade --refresh || box_update_fail dnf     # --refresh pulls fresh metadata first; dnf prompts
    ;;
esac

box_update_summary
