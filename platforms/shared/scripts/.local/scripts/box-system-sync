#!/usr/bin/env bash
#
# Applies every box change to this machine in one go.
#
#   box-system-sync      # packages, configs, scripts, defaults, plugins, mise
#
# The front door for "I edited box, now update this machine". It runs the
# install modules that reconcile the repo onto a machine, and skips the ones
# that only make sense on a fresh machine: 01-preflight (xcode, homebrew, sudo)
# and 05-settings (dock, finder, keyboard), which would stomp settings you have
# since changed by hand.
#
# Every step it runs is idempotent, so re-running is always safe.
#
# To sync a config package or two by name instead, use _box-config-sync.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

box="${BOX_ROOT:-$HOME/box}"
os="$(_box-os-detect)"

for module in 02-packages 03-configs 04-postinstall; do
  setup="$box/platforms/$os/modules/$module/setup.sh"

  if [[ ! -x $setup ]]; then
    echo "❌ box-system-sync: no $module module for $os at $setup" >&2
    exit 1
  fi

  "$setup"
done

echo "✅ box: all synced"
