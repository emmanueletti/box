#!/usr/bin/env bash
#
# Reports outdated mise tools -- the language runtimes and CLIs box pins.
#
#   box-tools-outdated
#
# mise tools are separate from system packages: they are pinned per-user in
# ~/.config/mise/config.toml, never need sudo, and box-pkgs-* does not touch
# them. box-pkgs-outdated covers brew/pacman/dnf instead.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

box_check_section() {
  printf '\n\033[1m== %s ==\033[0m\n' "$1"
}

box_check_section_ok() {
  printf '\n\033[1m== %s ==\033[0m ✅\n' "$1"
}

box_check_require() {
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "❌ ${0##*/}: required tool '$1' not installed (box should have set it up)" >&2
  exit 1
}

box_check_require mise

# Run from $HOME so only the global toolset is checked, not a project's tools.
out="$(cd "$HOME" && mise outdated 2>&1)" || {
  rc=$?
  echo "❌ ${0##*/}: 'mise outdated' failed (exit $rc)" >&2
  exit "$rc"
}

if [[ $out =~ "up to date" ]]; then
  box_check_section_ok "tools (mise)"
else
  box_check_section "tools (mise)"
  printf '%s\n' "$out"
fi
