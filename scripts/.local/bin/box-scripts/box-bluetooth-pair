#!/usr/bin/env bash
#
# Pairs a new bluetooth device: scans, then pairs, trusts and connects the one
# you pick. Trusting is what lets it reconnect on its own later.
#
#   box-bluetooth-pair     # scan for 10 seconds, then pick
#   box-bluetooth-pair 20  # scan for 20 seconds

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"

os="$("$lib/os-detect")"

if [[ $os == "macos" ]]; then
  echo "❌ box: box-bluetooth-pair uses bluetoothctl, which only exists on linux" >&2
  exit 1
fi

seconds="${1:-10}"

bluetoothctl power on >/dev/null

echo "box: put the device in pairing mode, scanning for ${seconds}s"
bluetoothctl --timeout "$seconds" scan on >/dev/null

paired="$(bluetoothctl devices Paired | cut -d' ' -f2)"
found="$(bluetoothctl devices | grep -vFf <(printf '%s\n' "$paired" | grep . || echo "no-paired-devices") || true)"

if [[ -z $found ]]; then
  echo "box-bluetooth-pair: found nothing new, is the device in pairing mode?" >&2
  exit 1
fi

choice="$(fzf --prompt='pair> ' --with-nth=3.. <<<"$found")" || exit 0

mac="$(cut -d' ' -f2 <<<"$choice")"
name="$(cut -d' ' -f3- <<<"$choice")"

bluetoothctl pair "$mac" >/dev/null
bluetoothctl trust "$mac" >/dev/null
bluetoothctl connect "$mac" >/dev/null

echo "✅ box-bluetooth-pair: paired and connected to $name"
