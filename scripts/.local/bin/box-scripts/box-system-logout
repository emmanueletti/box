#!/usr/bin/env bash
#
# Logs out of the desktop session, closing every app, after asking first.
#
#   box-system-logout              # asks first: [y/N] in a terminal, rofi otherwise
#   box-system-logout --noconfirm  # no question, for menus that already confirmed

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"

if [[ ${1:-} != "--noconfirm" ]]; then
  "$lib/confirm" "Log out now? Every app closes." || { echo "Cancelled."; exit 0; }
fi

os="$("$lib/os-detect")"

case $os in
  arch) swaymsg exit ;;
  fedora) gnome-session-quit --logout --no-prompt ;;
  macos) osascript -e 'tell application "System Events" to log out' ;;
esac
