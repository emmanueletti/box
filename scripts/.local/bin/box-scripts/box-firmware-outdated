#!/usr/bin/env bash
#
# Reports pending firmware/BIOS updates.
#
#   box-firmware-outdated      # Linux fwupd; on macOS firmware ships with the OS
#
# Only Linux has real work here. Apple ships firmware through softwareupdate,
# so on macOS box-os-outdated is what reports it.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

box_check_section() {
  printf '\n\033[1m== %s ==\033[0m\n' "$1"
}

box_check_section_ok() {
  printf '\n\033[1m== %s ==\033[0m ✅\n' "$1"
}

box_check_require() {
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "❌ ${0##*/}: required tool '$1' not installed (box should have set it up)" >&2
  exit 1
}

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"

os="$("$lib/os-detect")"

case "$os" in
  macos)
    box_check_section "firmware & BIOS"
    echo "macOS firmware ships through softwareupdate; run box-os-outdated"
    ;;

  arch | fedora)
    box_check_require fwupdmgr
    fwupdmgr refresh --force >/dev/null 2>&1 || true   # refresh metadata; 2 == already current

    rc=0
    out="$(fwupdmgr get-updates 2>&1)" || rc=$?
    if (( rc != 0 && rc != 2 )); then
      echo "❌ ${0##*/}: 'fwupdmgr get-updates' failed (exit $rc)" >&2
      exit "$rc"
    fi

    if (( rc == 2 )); then   # exit 2 == nothing to update
      box_check_section_ok "firmware & BIOS"
    else
      box_check_section "firmware & BIOS"
      [[ -n $out ]] && printf '%s\n' "$out"
    fi
    ;;
esac
