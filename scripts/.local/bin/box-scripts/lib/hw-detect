#!/usr/bin/env bash
#
# Prints this machine's hardware identity: vendor, model and firmware/BIOS.
#
#   hw-detect
#
# Read-only, no sudo. Reads DMI on Linux and sysctl on macOS. box-system-outdated
# runs it for context.

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

os="$("$lib/os-detect")"

# Value of a readable file, or "unknown" when absent.
val() {
  [[ -r $1 ]] && printf '%s' "$(<"$1")" || printf 'unknown'
}

row() {
  printf '%-8s %s\n' "$1" "$2"
}

case "$os" in
  macos)
    row vendor: Apple
    row model: "$(sysctl -n hw.model 2>/dev/null || echo unknown)"
    row chip: "$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown)"
    ;;

  arch | fedora)
    dmi=/sys/class/dmi/id
    row vendor: "$(val "$dmi/sys_vendor")"
    row model: "$(val "$dmi/product_name")"
    row bios: "$(val "$dmi/bios_version")"
    ;;
esac
