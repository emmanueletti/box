#!/usr/bin/env bash
#
# Sets the default image viewer, for every image type it opens.
#
#   box-default-image imv  # finds the installed app matching "imv",
#                          # shows it, and asks before setting it

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

if (( $# == 0 )); then
  echo "usage: box-default-image <name>" >&2
  exit 1
fi

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"

exec "$lib/default-app" image "$1"
