#!/usr/bin/env bash
#
# Shuts the machine down, after asking first.
#
#   box-system-shutdown              # asks first: [y/N] in a terminal, rofi otherwise
#   box-system-shutdown --noconfirm  # no question, for menus that already confirmed

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"

if [[ ${1:-} != "--noconfirm" ]]; then
  "$lib/confirm" "Shut down now?" || { echo "Cancelled."; exit 0; }
fi

os="$("$lib/os-detect")"

case $os in
  arch | fedora) systemctl poweroff ;;
  macos) osascript -e 'tell application "System Events" to shut down' ;;
esac
