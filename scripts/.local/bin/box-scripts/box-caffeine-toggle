#!/usr/bin/env bash
#
# Toggles a systemd inhibit lock that blocks idle/sleep, like macOS Caffeine.
#
#   box-caffeine-toggle   # on if off, off if on

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

unit="box-caffeine"

if systemctl --user is-active --quiet "$unit.service"; then
  systemctl --user stop "$unit.service"
  pkill -RTMIN+9 waybar || true
  echo "✅ box-caffeine-toggle: off"
else
  systemd-run --user --quiet --unit="$unit" \
    systemd-inhibit --what=idle:sleep --why="box-caffeine-toggle" sleep infinity
  pkill -RTMIN+9 waybar || true
  echo "✅ box-caffeine-toggle: on"
fi
