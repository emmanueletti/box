#!/usr/bin/env bash
#
# Compresses files into an archive (format picked from the output name).
#
#   box-zip-compress f1 dir/ out.tar.zst

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

if (( $# < 2 )); then
  echo "usage: box-zip-compress <path>... <archive>" >&2
  exit 1
fi

bsdtar -acf "${@: -1}" "${@:1:$#-1}"
