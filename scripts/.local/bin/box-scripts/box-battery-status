#!/usr/bin/env bash
#
# Prints battery charge with a fullness-level glyph, e.g. " 87%".
# Requires a Nerd Font. Prints nothing on machines without a battery (desktops).
#
#   box-battery-status            #  87%
#   box-battery-status --plain    # 87

set -euo pipefail

[[ ${1:-} == -h ]] && exec box-help "$0"

os="$(_box-os-detect)"

pct=""

if [[ $os == "macos" ]]; then
  # A desktop Mac has no percentage to print, so grep finds nothing and the
  # pipeline fails. || true keeps set -e from killing us before the empty-pct
  # check below, which is what actually handles "no battery".
  pct="$(pmset -g batt | grep -o '[0-9]\+%' | head -1 | tr -d '%' || true)"
else
  for bat in /sys/class/power_supply/BAT*; do
    [[ -r $bat/capacity ]] || continue
    pct="$(<"$bat/capacity")"
    break
  done
fi

[[ -n $pct ]] || exit 0

if [[ ${1:-} == "--plain" ]]; then
  echo "$pct"
  exit 0
fi

if (( pct <= 10 )); then
  icon=""
elif (( pct <= 35 )); then
  icon=""
elif (( pct <= 60 )); then
  icon=""
elif (( pct <= 85 )); then
  icon=""
else
  icon=""
fi

echo "$icon $pct%"
